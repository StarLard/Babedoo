          }
        }
      }
    },
    "%@ and its developer take your privacy very seriously. %@ does not collect any data about you. Ever. To learn more, read our %@." : {
      "comment" : "Privacy statement; the first two placeholders are the app name and the last is a link to the privacy policy",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ und sein Entwickler nehmen deine Privatsphäre sehr ernst. %@ erfasst keinerlei Daten über dich. Niemals. Mehr dazu erfährst du in unserer %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ y su desarrollador se toman muy en serio tu privacidad. %@ no recopila ningún dato sobre ti. Nunca. Para obtener más información, lee nuestra %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ et son développeur prennent votre vie privée très au sérieux. %@ ne collecte aucune donnée vous concernant. Jamais. Pour en savoir plus, consultez notre %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@とその開発者は、プライバシーをとても大切に考えています。%@がユーザに関するデータを収集することは決してありません。詳しくは、%@をお読みください。"
          }
        }
      }
    },
    "%@ complete, %@ %@ along, %@ %@ to go" : {
      "comment" : "Accessibility value for the progress summary; placeholders are the percent complete, the time along, and the time remaining",
