            {
              "kind": "group",
              "path": "Components",
              "children": [
                { "path": "CopyrightNotice.swift", "target-membership": [ "Babedoo/compile-sources" ] },
              ],
            },
            { "path": "DueDateView.swift", "target-membership": [ "Babedoo/compile-sources" ] },
            { "path": "PregnancyProgressView.swift", "target-membership": [ "Babedoo/compile-sources" ] },
            { "path": "AppInfoView.swift", "target-membership": [ "Babedoo/compile-sources" ] },
            { "path": "PrivacyInfoView.swift", "target-membership": [ "Babedoo/compile-sources" ] },
          ],
        },
