      "children": [
        { "path": "BabedooTests.swift", "target-membership": [ "BabedooTests/compile-sources" ] },
      ],
    }, {
      "kind": "group",
      "path": "BabedooUITests",
      "children": [
        { "path": "BabedooUITests.swift", "target-membership": [ "BabedooUITests/compile-sources" ] },
        { "path": "BabedooUITestsLaunchTests.swift", "target-membership": [ "BabedooUITests/compile-sources" ] },
      ],
